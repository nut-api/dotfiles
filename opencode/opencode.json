{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-154336bb-0287-43b9-8fd4-a0c80b4806c7"
      },
      "enabled": true
    },
    "kubernetes-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "enabled": true
    },
    "web-search": {
      "type": "local",
      "command": ["npx", "-y", "open-websearch@latest"],
      "enabled": true,
      "environment": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "ALLOWED_SEARCH_ENGINES": "duckduckgo,bing,exa"
      },
    }
  },
  "plugin": [
    "opencode-anthropic-oauth@latest"
  ]
  // "mode": {
  //   "build": {
  //     "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
  //   }
  // }
}
