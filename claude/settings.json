{
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk read *)",
      "Bash(rtk grep *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "weekly-update": "user-invocable-only",
    "weekly-summary": "user-invocable-only",
    "fast-pr": "user-invocable-only",
    "post-mortem": "user-invocable-only",
    "management-talk": "user-invocable-only",
    "write-a-skill": "user-invocable-only",
    "to-issues": "user-invocable-only",
    "to-prd": "user-invocable-only",
    "find-skills": "user-invocable-only",
    "article-writing": "user-invocable-only",
    "qwen-agent": "name-only",
    "qwenchance": "name-only",
    "firecrawl": "name-only",
    "system-design-docs": "name-only",
    "context7-mcp": "name-only",
    "grafana-dashboard-layout": "name-only",
    "helm-chart-functional-testing": "name-only",
    "caveman": "off",
    "tdd": "off",
    "prototype": "off",
    "diagnose": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi | grep -E '^(description|sessions):'; echo 'help: run `lavish-axi` (no args) for full usage, playbooks and design rules before building an artifact'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/opt/homebrew/bin/bun\" --env-file /dev/null \"${plugin_dir}src/index.ts\"'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": false,
    "caveman@caveman": true,
    "andrej-karpathy-skills@karpathy-skills": false,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen"
}
